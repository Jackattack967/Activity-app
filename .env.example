# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# must never be committed — this template exists so the repo can document
# what the app needs without publishing any of it.
#
# Nothing here is required to browse schedules. The app boots and serves the
# dashboard with none of these set; each block below only switches on an
# optional feature.

# --- Accounts (sign-in, saved preferences, watched activities) ---------------
# All four are required together; if any is missing, accounts stay disabled
# and the dashboard runs read-only.
#
# DATABASE_URL: Postgres connection string, e.g. from Neon.
# GOOGLE_CLIENT_ID / _SECRET: from a Google Cloud OAuth 2.0 Client ID
#   (console.cloud.google.com > APIs & Services > Credentials).
# FLASK_SECRET_KEY: signs the login cookie. Generate a fresh random one:
#   python -c "import secrets; print(secrets.token_hex(32))"
DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FLASK_SECRET_KEY=

# --- Web Push (browser notifications when a spot opens) ---------------------
# Generate the key pair once with:  vapid --gen
# VAPID_CLAIM_EMAIL must be a mailto: URL, e.g. mailto:alerts@example.com —
# push services use it to contact the sender about delivery problems.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=

# --- Scheduled watch checks -------------------------------------------------
# Shared secret the external scheduler presents to /api/check-watches. Any
# long random string; the endpoint refuses to run if it is unset.
WATCH_CHECK_TOKEN=

# --- Email alerts (optional) ------------------------------------------------
# Set at most one provider key. Brevo takes precedence if both are present.
# Without either, the email-alert option stays hidden and push is unaffected.
# ALERT_FROM_EMAIL must be a sender address verified with that provider.
BREVO_API_KEY=
RESEND_API_KEY=
ALERT_FROM_EMAIL=

# Canada's anti-spam law (CASL) requires every alert email to identify the
# sender by name and give a mailing address where they can be reached, and to
# carry an unsubscribe link. If SENDER_NAME and SENDER_MAILING_ADDRESS are not
# both set, alert emails are refused rather than sent non-compliant — the
# server log says so. Push notifications are unaffected either way.
#
# Put a real postal address here, never in the code: this file is a template
# and stays empty, but `.env` is gitignored so the real value is not published.
# Example: Jack Eaton / 123 Example St, Coquitlam BC V3B 0A1, Canada
SENDER_NAME=
SENDER_MAILING_ADDRESS=

# Base URL used to build unsubscribe links in emails, e.g.
# https://activity-schedule-dashboard.onrender.com — no trailing slash.
# On Render this is filled in automatically from RENDER_EXTERNAL_URL, so it
# only needs setting for local testing or once a custom domain is in use.
PUBLIC_BASE_URL=

# --- Public contact address -------------------------------------------------
# Shown as the privacy/data contact on /privacy and /account/delete. Use a
# role address (privacy@yourdomain.ca), not a personal one. If left unset,
# those pages point at the self-serve deletion flow instead.
CONTACT_EMAIL=

# --- Deleting unused accounts (retention) -----------------------------------
# Holding someone's data forever because they signed up once is what privacy
# law asks you not to do, so accounts that go unused are deleted. Someone is
# emailed 30 days beforehand, and signing in cancels it.
#
# Nothing is deleted and no warning is sent until RETENTION_ENABLED is set:
# unset, the daily job only reports what it *would* do, so the date logic can
# be watched against real accounts before it is trusted with them. Leave it
# unset for the first few weeks, check the job output, then turn it on.
RETENTION_ENABLED=

# Days of no use before an account is deleted, and how much notice is given.
# Both are optional; the defaults are 180 and 30.
RETENTION_INACTIVE_DAYS=
RETENTION_WARN_DAYS=

# --- In-app watch loop ------------------------------------------------------
# The app runs its own watch pass on a timer while it is awake, so alerting
# does not depend entirely on an external scheduler. It defers to the external
# one: if a pass ran in the last AUTOWATCH_MIN_GAP_SECONDS, it sits that turn
# out, so the two never double up.
#
# All optional. Defaults: on, every 300s, skipping if a pass ran in the last
# 240s. Set AUTOWATCH_ENABLED=false to fall back to the external scheduler
# alone without a redeploy.
AUTOWATCH_ENABLED=
AUTOWATCH_INTERVAL_SECONDS=
AUTOWATCH_MIN_GAP_SECONDS=
