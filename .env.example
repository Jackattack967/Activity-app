# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# must never be committed — this template exists so the repo can document
# what the app needs without publishing any of it.
#
# Nothing here is required to browse schedules. The app boots and serves the
# dashboard with none of these set; each block below only switches on an
# optional feature.

# --- Accounts (sign-in, saved preferences, watched activities) ---------------
# All four are required together; if any is missing, accounts stay disabled
# and the dashboard runs read-only.
#
# DATABASE_URL: Postgres connection string, e.g. from Neon.
# GOOGLE_CLIENT_ID / _SECRET: from a Google Cloud OAuth 2.0 Client ID
#   (console.cloud.google.com > APIs & Services > Credentials).
# FLASK_SECRET_KEY: signs the login cookie. Generate a fresh random one:
#   python -c "import secrets; print(secrets.token_hex(32))"
DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FLASK_SECRET_KEY=

# --- Web Push (browser notifications when a spot opens) ---------------------
# Generate the key pair once with:  vapid --gen
# VAPID_CLAIM_EMAIL must be a mailto: URL, e.g. mailto:alerts@example.com —
# push services use it to contact the sender about delivery problems.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=

# --- Scheduled watch checks -------------------------------------------------
# Shared secret the external scheduler presents to /api/check-watches. Any
# long random string; the endpoint refuses to run if it is unset.
WATCH_CHECK_TOKEN=

# --- Email alerts (optional) ------------------------------------------------
# Set at most one provider key. Brevo takes precedence if both are present.
# Without either, the email-alert option stays hidden and push is unaffected.
# ALERT_FROM_EMAIL must be a sender address verified with that provider.
BREVO_API_KEY=
RESEND_API_KEY=
ALERT_FROM_EMAIL=

# --- Public contact address -------------------------------------------------
# Shown as the privacy/data contact on /privacy and /account/delete. Use a
# role address (privacy@yourdomain.ca), not a personal one. If left unset,
# those pages point at the self-serve deletion flow instead.
CONTACT_EMAIL=
